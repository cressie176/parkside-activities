# Environment variables read by the dev scripts. All optional; defaults shown.
# Not loaded automatically: set them in your shell, e.g.
#   API_PORT=3117 WEB_PORT=5117 npm run dev

# Port for the Express API (server/index.ts). Vite proxies /api to it.
API_PORT=3001
# Port for the Vite dev server (strictPort, so it fails rather than drifting).
WEB_PORT=5173
# SQLite file used by the API and `npm run seed`. Relative paths resolve from the repo root.
DB_PATH=parkside.db
